package com.zornoely.duel;

import net.kyori.adventure.text.Component;
import net.kyori.adventure.text.event.ClickEvent;
import net.kyori.adventure.text.event.HoverEvent;
import net.kyori.adventure.text.format.NamedTextColor;
import org.bukkit.Bukkit;
import org.bukkit.ChatColor;
import org.bukkit.Location;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.CommandSender;
import org.bukkit.command.TabCompleter;
import org.bukkit.entity.Player;
import org.bukkit.metadata.FixedMetadataValue;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import java.util.UUID;

public class DuelCommand implements CommandExecutor, TabCompleter {
    private static final List<String> ADMIN_SUBS =
            List.of("create", "delete", "sil", "setspawn1", "setspawn2", "settype", "tp");

    private final ZornoElyDuel plugin;

    public DuelCommand(ZornoElyDuel plugin) { this.plugin = plugin; }

    private boolean isAdmin(CommandSender s) {
        return s.hasPermission("zornoely.admin") || s.isOp();
    }

    /** Admin değilse mesaj atar ve true döner. */
    private boolean denyIfNotAdmin(Player p) {
        if (isAdmin(p)) return false;
        p.sendMessage(ChatColor.RED + "Yetkin yok!");
        return true;
    }

    @Override
    public boolean onCommand(CommandSender sender, Command cmd, String label, String[] args) {
        if (!(sender instanceof Player p)) {
            sender.sendMessage(ChatColor.RED + "Sadece oyuncular kullanabilir.");
            return true;
        }
        if (args.length == 0) {
            p.sendMessage(ChatColor.RED + "Kullanım: /duel <davet|kabul|reddet|menu|sandik|berabere|list>");
            return true;
        }

        switch (args[0].toLowerCase(Locale.ROOT)) {
            case "berabere"          -> handleBerabere(p);
            case "list"              -> handleList(p);
            case "tp"                -> handleTp(p, args);
            case "settype"           -> handleSetType(p, args);
            case "create"            -> handleCreate(p, args);
            case "delete", "sil"     -> handleDelete(p, args);
            case "setspawn1"         -> handleSetSpawn(p, args, 1);
            case "setspawn2"         -> handleSetSpawn(p, args, 2);
            case "sandik", "sandık"  -> plugin.getLootManager().openLoot(p);
            case "menu", "menü"      -> GUI.openQueue(p, plugin);
            case "davet"             -> handleDavet(p, args);
            case "kabul"             -> handleKabul(p, args);
            case "reddet"            -> handleReddet(p, args);
            default -> p.sendMessage(ChatColor.RED + "Bilinmeyen komut: " + args[0]);
        }
        return true;
    }

    /** Berabere artık karşılıklı: iki oyuncu da yazmalı (aksi halde kaybeden kaçabilirdi). */
    private void handleBerabere(Player p) {
        Duel duel = plugin.getDuelManager().getDuel(p.getUniqueId());
        if (duel == null) {
            p.sendMessage(ChatColor.RED + "Aktif bir düelloda değilsiniz!");
            return;
        }
        UUID oppId = duel.getOpponent(p.getUniqueId());
        Player opp = oppId != null ? Bukkit.getPlayer(oppId) : null;

        if (oppId != null && duel.getDrawVotes().contains(oppId)) {
            plugin.getDuelManager().endDuel(duel, null, "DRAW");
            String msg = ChatColor.YELLOW + "Düello berabere sonlandırıldı!";
            p.sendMessage(msg);
            if (opp != null && opp.isOnline()) opp.sendMessage(msg);
            plugin.sendToHub(p);
            if (opp != null && opp.isOnline()) plugin.sendToHub(opp);
            return;
        }

        if (!duel.getDrawVotes().add(p.getUniqueId())) {
            p.sendMessage(ChatColor.YELLOW + "Zaten berabere teklif ettin, rakibin kabul etmesini bekle.");
            return;
        }
        p.sendMessage(ChatColor.YELLOW + "Berabere teklifin gönderildi. Rakibin de /duel berabere yazarsa düello biter.");
        if (opp != null && opp.isOnline()) {
            opp.sendMessage(ChatColor.YELLOW + p.getName() + " berabere teklif ediyor! Kabul etmek için: /duel berabere");
        }
    }

    private void handleList(Player p) {
        if (plugin.getArenaManager().getAll().isEmpty()) {
            p.sendMessage(ChatColor.RED + "Hiç arena yok!");
            return;
        }
        p.sendMessage(ChatColor.YELLOW + "--- Arena Listesi ---");
        boolean admin = isAdmin(p);
        for (Arena a : plugin.getArenaManager().getAll()) {
            Component line = Component.text("- ", NamedTextColor.GRAY)
                    .append(Component.text(a.getName(), NamedTextColor.WHITE))
                    .append(Component.text(" [", NamedTextColor.DARK_GRAY))
                    .append(a.isBusy() ? Component.text("DOLU", NamedTextColor.RED)
                                       : Component.text("BOŞ", NamedTextColor.GREEN))
                    .append(Component.text("]", NamedTextColor.DARK_GRAY))
                    .append(Component.text(" (Tip: ", NamedTextColor.GRAY))
                    .append(Component.text(a.getType().name(), NamedTextColor.YELLOW))
                    .append(Component.text(")", NamedTextColor.GRAY));
            if (admin) {
                line = line.append(Component.text(" [IŞINLAN]", NamedTextColor.GREEN)
                        .clickEvent(ClickEvent.runCommand("/duel tp " + a.getName()))
                        .hoverEvent(HoverEvent.showText(Component.text("Arenaya ışınlan", NamedTextColor.GRAY))));
            }
            p.sendMessage(line);
        }
    }

    private void handleTp(Player p, String[] args) {
        if (denyIfNotAdmin(p)) return;
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel tp <arena>"); return; }
        Arena a = plugin.getArenaManager().get(args[1]);
        if (a == null) { p.sendMessage(ChatColor.RED + "Arena bulunamadı!"); return; }
        Location l = a.getSpawn1();
        if (l == null) { p.sendMessage(ChatColor.RED + "Spawn 1 ayarlanmamış veya dünyası yüklü değil!"); return; }
        p.teleport(l);
        p.sendMessage(ChatColor.GREEN + "Işınlandın: " + a.getName());
    }

    private void handleSetType(Player p, String[] args) {
        if (denyIfNotAdmin(p)) return;
        if (args.length < 3) { p.sendMessage(ChatColor.RED + "Kullanım: /duel settype <arena> <elytra|trap|hepsi>"); return; }
        Arena a = plugin.getArenaManager().get(args[1]);
        if (a == null) { p.sendMessage(ChatColor.RED + "Arena bulunamadı!"); return; }
        ArenaType t = ArenaType.fromString(args[2]);
        if (t == null) { p.sendMessage(ChatColor.RED + "Geçersiz tip! Kullan: elytra, trap veya hepsi"); return; }
        a.setType(t);
        plugin.getArenaManager().save();
        p.sendMessage(ChatColor.GREEN + "Arena " + a.getName() + " tipi: " + t);
    }

    private void handleCreate(Player p, String[] args) {
        if (denyIfNotAdmin(p)) return;
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel create <arena>"); return; }
        if (!ArenaManager.isValidName(args[1])) {
            p.sendMessage(ChatColor.RED + "Arena adı sadece harf, rakam, _ ve - içerebilir (en fazla 32 karakter).");
            return;
        }
        Arena created = plugin.getArenaManager().create(args[1]);
        if (created == null) {
            p.sendMessage(ChatColor.RED + "Bu isimde arena zaten var!");
            return;
        }
        plugin.getArenaManager().save();
        p.sendMessage(ChatColor.GREEN + "Arena oluşturuldu: " + created.getName() + " (Tip: HEPSI)");
    }

    private void handleDelete(Player p, String[] args) {
        if (denyIfNotAdmin(p)) return;
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel delete <arena>"); return; }
        Arena a = plugin.getArenaManager().get(args[1]);
        if (a == null) { p.sendMessage(ChatColor.RED + "Arena bulunamadı!"); return; }
        if (a.isBusy()) { p.sendMessage(ChatColor.RED + "Arenada şu an maç var, silinemez!"); return; }
        plugin.getArenaManager().delete(a.getName());
        plugin.getArenaManager().save();
        p.sendMessage(ChatColor.GREEN + "Arena silindi: " + a.getName());
    }

    private void handleSetSpawn(Player p, String[] args, int num) {
        if (denyIfNotAdmin(p)) return;
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel setspawn" + num + " <arena>"); return; }
        Arena a = plugin.getArenaManager().get(args[1]);
        if (a == null) { p.sendMessage(ChatColor.RED + "Arena bulunamadı!"); return; }
        if (num == 1) a.setSpawn1(p.getLocation());
        else          a.setSpawn2(p.getLocation());
        plugin.getArenaManager().save();
        p.sendMessage(ChatColor.GREEN + "Spawn " + num + " ayarlandı: " + a.getName());
    }

    private void handleDavet(Player p, String[] args) {
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel davet <oyuncu>"); return; }
        Player target = Bukkit.getPlayerExact(args[1]);
        if (target == null) { p.sendMessage(ChatColor.RED + "Oyuncu bulunamadı!"); return; }
        if (target.equals(p)) { p.sendMessage(ChatColor.RED + "Kendine davet atamazsın!"); return; }
        if (plugin.getDuelManager().isInDuel(target.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Bu oyuncu şu an düelloda!");
            return;
        }
        if (plugin.getLootManager().hasLoot(p.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Önce ganimetini almalısın! (/duel sandik)");
            return;
        }
        p.setMetadata("duel_target", new FixedMetadataValue(plugin, target.getUniqueId().toString()));
        GUI.openInvite(p, target);
    }

    private void handleKabul(Player p, String[] args) {
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel kabul <oyuncu>"); return; }
        Player inviter = Bukkit.getPlayerExact(args[1]);
        if (inviter == null) { p.sendMessage(ChatColor.RED + "Oyuncu offline!"); return; }
        InviteManager.Invite inv = plugin.getInviteManager().getInvite(inviter.getUniqueId());
        if (inv == null || !inv.target.equals(p.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Aktif davet yok!");
            return;
        }
        DuelManager dm = plugin.getDuelManager();
        if (dm.isInDuel(inviter.getUniqueId())) {
            plugin.getInviteManager().removeInvite(inviter.getUniqueId());
            p.sendMessage(ChatColor.RED + "Davet eden oyuncu şu an düelloda!");
            return;
        }
        if (plugin.getLootManager().hasLoot(p.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Önce ganimetini almalısın! (/duel sandik)");
            return;
        }
        if (plugin.getLootManager().hasLoot(inviter.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Davet eden oyuncu şu an ganimetini topluyor, birazdan tekrar dene.");
            return;
        }
        if (plugin.getArenaManager().findAvailable(inv.mode) == null) {
            p.sendMessage(ChatColor.RED + "Şu an boş arena yok, biraz sonra tekrar dene.");
            return;
        }
        plugin.getInviteManager().removeInvite(inviter.getUniqueId());
        if (dm.startDuel(inviter, p, inv.mode) == null) {
            p.sendMessage(ChatColor.RED + "Düello başlatılamadı!");
        }
    }

    private void handleReddet(Player p, String[] args) {
        if (args.length < 2) { p.sendMessage(ChatColor.RED + "Kullanım: /duel reddet <oyuncu>"); return; }
        Player inviter = Bukkit.getPlayerExact(args[1]);
        if (inviter == null) { p.sendMessage(ChatColor.RED + "Oyuncu offline!"); return; }
        InviteManager.Invite inv = plugin.getInviteManager().getInvite(inviter.getUniqueId());
        if (inv == null || !inv.target.equals(p.getUniqueId())) {
            p.sendMessage(ChatColor.RED + "Aktif davet yok!");
            return;
        }
        plugin.getInviteManager().removeInvite(inviter.getUniqueId());
        p.sendMessage(ChatColor.GREEN + "Daveti reddettin.");
        inviter.sendMessage(ChatColor.RED + p.getName() + " davetini reddetti.");
    }

    @Override
    public List<String> onTabComplete(CommandSender sender, Command cmd, String label, String[] args) {
        List<String> out = new ArrayList<>();
        boolean admin = isAdmin(sender);

        if (args.length == 1) {
            List<String> opts = new ArrayList<>(List.of("davet", "kabul", "reddet", "menu", "sandik", "berabere", "list"));
            if (admin) opts.addAll(ADMIN_SUBS);
            String typed = args[0].toLowerCase(Locale.ROOT);
            for (String s : opts) if (s.startsWith(typed)) out.add(s);
        } else if (args.length == 2) {
            String sub = args[0].toLowerCase(Locale.ROOT);
            String typed = args[1].toLowerCase(Locale.ROOT);
            if (List.of("davet", "kabul", "reddet").contains(sub)) {
                for (Player pl : Bukkit.getOnlinePlayers())
                    if (pl.getName().toLowerCase(Locale.ROOT).startsWith(typed)) out.add(pl.getName());
            } else if (admin && ADMIN_SUBS.contains(sub)) {
                for (String name : plugin.getArenaManager().getNames())
                    if (name.toLowerCase(Locale.ROOT).startsWith(typed)) out.add(name);
            }
        } else if (args.length == 3 && admin && args[0].equalsIgnoreCase("settype")) {
            String typed = args[2].toLowerCase(Locale.ROOT);
            for (String s : List.of("elytra", "trap", "hepsi"))
                if (s.startsWith(typed)) out.add(s);
        }
        return out;
    }
}

